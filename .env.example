# demo = explicitly labeled deterministic coach (no API needed)
# local = open-weight model running next to the application server
# hosted = remote OpenAI-compatible endpoint (observations leave the server)
LLM_PROVIDER=demo
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=your-local-model
LOCAL_LLM_API_KEY=
HOSTED_LLM_BASE_URL=https://api.openai.com/v1
HOSTED_LLM_MODEL=
HOSTED_LLM_API_KEY=
# Local persistent MongoDB (start with: docker compose up -d --wait)
# APP_ENV is separate from NODE_ENV: npm start can still use APP_ENV=local.
APP_ENV=local
MONGODB_URI=mongodb://127.0.0.1:27017/observation_coach?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=observation_coach
# Set true behind an HTTPS production reverse proxy.
COOKIE_SECURE=false

# For an HTTPS iframe preview only: SameSite=None; Secure; Partitioned.
COOKIE_EMBEDDED=false

# Logging: LOG_LEVEL = debug | info | warn | error | silent (default debug locally).
# LOG_HTTP turns Apache "combined" access logs (morgan format) on/off; they default
# on when APP_ENV=hosted and off locally. Logs never include secrets or reflections.
LOG_LEVEL=debug
LOG_HTTP=false
