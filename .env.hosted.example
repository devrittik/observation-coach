# Configure these as server-side secrets on your hosting platform.
# Do not commit real credentials, or expose them with NEXT_PUBLIC_.
APP_ENV=hosted
MONGODB_URI=mongodb+srv://YOUR_DATABASE_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=observation_coach
COOKIE_SECURE=true
# Set true only if the HTTPS hosted application runs inside a cross-site iframe.
COOKIE_EMBEDDED=false

# Database selection is independent of LLM selection. No model setting was changed.
LLM_PROVIDER=demo
# To enable an existing hosted LLM, set LLM_PROVIDER=hosted and supply:
HOSTED_LLM_BASE_URL=
HOSTED_LLM_MODEL=
HOSTED_LLM_API_KEY=
